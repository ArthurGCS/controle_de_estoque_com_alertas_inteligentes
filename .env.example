# MySQL
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=''
MYSQL_DATABASE=estoque_monitor

# Alert behavior
# Options: smtp, whatsapp. Use comma separated values for both.
ALERT_CHANNELS=smtp
ALERT_REPEAT_HOURS=24
MAX_ALERT_ITEMS=25
DRY_RUN=true

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com
SMTP_TO=buyer@company.com,manager@company.com
SMTP_USE_TLS=true

# WhatsApp HTTP API
# For Meta WhatsApp Cloud API, use:
# https://graph.facebook.com/v20.0/<PHONE_NUMBER_ID>/messages
WHATSAPP_API_URL=
WHATSAPP_TOKEN=
WHATSAPP_TO=5511999999999

# Exports used by Power BI
POWERBI_EXPORT_DIR=powerbi/data
